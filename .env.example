# Database (PostgreSQL — локальная установка)
# Пользователь и БД создаются скриптом: .\scripts\setup-db.ps1 -PostgresPassword "ваш_пароль"
DATABASE_URL="postgresql://manuscript:manuscript@localhost:5432/manuscript?schema=public"

# Auth (Better Auth)
BETTER_AUTH_SECRET="change-me-to-random-32-char-string"
BETTER_AUTH_URL="http://localhost:3000"

# Encryption (for BYOK API keys)
ENCRYPTION_SECRET="change-me-to-random-32-char-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production (Amvera): listen address. Platform proxies containerPort 3000.
# PORT=3000
# BETTER_AUTH_URL="https://your-app.amvera.io"
# NEXT_PUBLIC_APP_URL="https://your-app.amvera.io"

# Optional: default AI provider for development
# OPENAI_API_KEY="sk-..."
