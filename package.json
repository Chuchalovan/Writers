{
  "name": "manuscript",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @manuscript/web dev",
    "build": "pnpm --filter @manuscript/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @manuscript/web db:generate",
    "db:migrate": "pnpm --filter @manuscript/web db:migrate",
    "db:studio": "pnpm --filter @manuscript/web db:studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
